##### GOSENDER #####
# enable gosender logging to the log file
GOSENDER_LOGGING=false
# minimul allowed speed for gosender
GOSENDER_MINSPEED=8000
# use gomail framework designed for golang
GOSENDER_USENEWENGINE=true
# adds List-Unsubscribe, Precedence and X-CSA-Complaints TAGS to the email
GOSENDER_USETRACKINGHEADERS=false
# Enable processing of random html tags with variables {HTML_RANDOM_P[x]} and {HTML_RANDOM_TABLE[x,y]} NOTE! it may slow down the whole sending
GOSENDER_RANDOMHTMLTAGS=true
# custom algorithm for masking the new tracking type tracking links using these values it replaces numbers with specified chars
GOSENDER_ALGORITHM={"0":"p","1":"s","2":"m","3":"z","4":"c","5":"k","6":"e","7":"r","8":"l","9":"o","u":"a"}
# tracking tag used to track messages in parser, caution with this as if it's changed it can affect whole sending process for not tracking send/bounced emails to the system
GOSENDER_TRACKTAG=Campuid
# debug option, only needed for development purposes
GOSENDER_DEBUG=false
# storage api timeout in seconds
GOSENDER_STORAGETIMEOUT=60
# custom made linker support to store all tracking links in it instead of storage then using new tracking v2
GOSENDER_ENABLELINKER=false
GOSENDER_LINKERURL=
GOSENDER_LINKERKEY=

#### TASK RUNNER ####
# below this load level the priority 3 tasks will work
TASKRUNNER_LOADLIMITVAL=20
# load limit when priority 3 tasks depend on the system load levels
TASKRUNNER_LOADLIMITENABLED=true
# enable logging in task runner
TASKRUNNER_LOGGING=true
# free duplicate tasks when requesting multiple times updating same object
TASKRUNNER_AUTOFREEQUEUE=true
# debug mode for developer
TASKRUNNER_DEBUG=false
# builtin web server for link tracking
TASKRUNNER_TRACKING=true
# old legacy implementation of tracking deprecated
TASKRUNNER_TRACKINGAS_HOST=135.181.2.16
TASKRUNNER_TRACKINGAS_DB=trackingas
TASKRUNNER_TRACKINGAS_USER=ses_remote
