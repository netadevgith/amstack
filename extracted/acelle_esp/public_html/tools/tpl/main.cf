data_directory = /var/lib/postfix-{NR}
queue_directory = /var/spool/postfix-{NR}
multi_instance_name = postfix-{NR}
inet_protocols = ipv4
inet_interfaces = {IP}
myhostname = {DNS}

compatibility_level = 2
authorized_submit_users =
mail_owner = postfix
mail_owner = postfix
mydestination = $myhostname, localhost.$mydomain, localhost
unknown_local_recipient_reject_code = 550
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
debugger_command =
         PATH=/bin:/usr/bin:/usr/local/bin:/usr/X11R6/bin
         ddd $daemon_directory/$process_name $process_id & sleep 5
sendmail_path = /usr/sbin/sendmail.postfix
newaliases_path = /usr/bin/newaliases.postfix
mailq_path = /usr/bin/mailq.postfix
setgid_group = postdrop
html_directory = no
manpage_directory = /usr/share/man
master_service_disable =
authorized_submit_users =
mynetworks = $myhostname, 185.253.63.4, 195.154.79.101, 62.210.6.114, 62.210.8.86, 62.210.9.87, 62.210.10.5, 62.210.13.211, 88.99.165.162, 212.129.63.197, 62.210.13.52, 163.172.124.251, 51.158.20.165, 51.158.20.230, 51.15.24.145, 116.202.114.66, 116.202.114.72, 116.202.114.73, 116.202.114.96
header_checks = regexp:/etc/postfix/header_checks
#bounce_queue_lifetime = 1d
bounce_queue_lifetime = 10m
smtp_tls_security_level = may
smtp_helo_name = $myhostname
always_add_missing_headers = yes
queue_run_delay = 10s
qmgr_message_active_limit = 40000
qmgr_message_recipient_limit = 40000
default_destination_concurrency_limit=100
smtp_destination_concurrency_limit=500
default_process_limit=200
maximal_backoff_time = 1000s
minimal_backoff_time = 300s
default_destination_rate_delay = 0
default_extra_recipient_limit = 10000
#smtp_connection_cache_on_demand = yes
#smtp_connection_cache_reuse_limit = 300
#smtp_connection_cache_time_limit = 30s
#smtp_connection_reuse_time_limit = 600s
smtp_connection_cache_on_demand=no
always_add_missing_headers = yes
smtpd_banner = $myhostname ESMTP $mail_name (Debian/GNU)
multi_instance_enable = yes
