sub change_server {
my ($email) = @_;
my $stat = `/usr/bin/perl \$HOME/public_html/tools/change_server_bymail $email`;
my $stat2 = `/usr/bin/perl \$HOME/public_html/tools/change_tracking_bymail $email`;
open(my $fh, '>>', $log_file);
print $fh "[ $host - " . timestamp() . "]: Changing server for: $email status: \n$stat\n$stat2\n";
close $fh;
}
$ssh->register_handler("stdout", sub {
        my($channel, $buffer) = @_;
        my $str = $buffer->bytes;
if ($str =~ /to=<([^>]+)>, (.*)/) {
my $account = $1;
chomp($account);
chomp($2);
# hardbounce
if ($2=~ /($regexp)/) {
if (!exists $catched_emails{$account}) {
write_log("$host -hardbounce issued on $account");
logsql("$host - Hardbounce detected on: $account");
write_bad($account);
}
$catched_emails{$account}++;
}
elsif ($2=~ /($optiona)/) { 
if (!exists $catched_emails{$account}) {
write_log("option a issued $account");
logsql("$host - Option A detected on $account, real event accoured, doing pause...");
#campaign_pause_auto($account);
campaign_pause_manual($account);
}
$catched_emails{$account}++;
}
elsif ($2=~ /($optionb)/) {
if (!exists $catched_emails{$account}) { 
write_log("option b issued $account");
logsql("$host - Option B detected on $account, real event accoured, doing pause...");
campaign_pause_manual($account);
}
$catched_emails{$account}++;
} # endif

} # END /to=<([^>]+)>, (.*)/

}); # END Handler

