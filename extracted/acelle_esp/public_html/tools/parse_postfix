# change tracking info and continue
sub campaign_pause_auto {
my ($email) = @_;
dbconn();
my $sth = $dbh->prepare("select campaigns.uid from subscribers inner join campaigns_lists_segments on subscribers.mail_list_id = campaigns_lists_segments.mail_list_id inner join campaigns on campaigns_lists_segments.campaign_id = campaigns.id where subscribers.email = ?");
$sth->execute($email);
my $campaigns = $sth->fetchall_arrayref({});
for my $camp (@$campaigns) {
my $redis = Redis->new(server => '127.0.0.1:6379', reconnect => 60);
$redis->set($camp->{uid}."_paused","Is backend $host, pagautas del hardbounce $email");
logsql("$host - Option A: Auto pausing campaign: $camp->{uid} by catched: $email");
auto_change_domain($camp->{uid},1);
logsql("$host - Option A: Resuming campaign: $camp->{uid}, domain replaced");
$redis->del($camp->{uid}."_paused");
#write_log("Catched regexp on $host, email: $email");
}
}

