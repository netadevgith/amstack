sub check_port {
my ($host,$port) = @_;
my $socket = IO::Socket::INET->new(PeerAddr => $host , PeerPort => $port , Proto => 'tcp' , Timeout => 3);
    #Check connection
    if( $socket )
    {
        return 0;
    }
    else
    {
        return 1;
    }

}

sub mark_server {
my ($id, $situation) = @_;
my $sta = $dbh->prepare("update sending_servers set status = ? where id = ?");
$sta->execute($situation,$id);
}

sub check_servers {
# schedule type
