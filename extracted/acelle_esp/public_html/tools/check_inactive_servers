my $sth = $dbh->prepare("select id,host,smtp_port as port from sending_servers");
$sth->execute();
my $count = 0;
my $arr = $sth->fetchall_arrayref({});
for my $server (@$arr) {
$count++;
#print "connecting to: $server->{host}\n";
if (check_port($server->{host},$server->{port})>0) {
mark_server($server->{id},"inactive");
} else {
mark_server($server->{id},"active");
