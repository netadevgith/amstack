put_file($ssh,"/multipostfix/tpl/master.cf","/root/tpl/master.cf");
log_msg("INFO", "Step 2 completed: config templates uploaded");

# upload minisvc if available (optional monitoring service)
if (-e $scriptdir."/minisvc") {
