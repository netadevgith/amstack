my $ua  = Mojo::UserAgent->new;

# Cloudflare API settings from environment
my $cf_email = $ENV{CLOUDFLARE_EMAIL} // '';
my $cf_apikey = $ENV{CLOUDFLARE_APIKEY} // '';
my $cf_api = 'https://api.cloudflare.com/client/v4';

sub log_msg {
    my ($level, $msg) = @_;
    my $tm = localtime;
    my $ts = sprintf("%04d-%02d-%02d %02d:%02d:%02d",
        $tm->year+1900, $tm->mon+1, $tm->mday, $tm->hour, $tm->min, $tm->sec);
    print "[$ts] [$level] $msg\n";
}

sub cf_headers {
    return {
        'X-Auth-Email' => $cf_email,
        'X-Auth-Key' => $cf_apikey,
        'Content-Type' => 'application/json'
    };
}

sub cf_get_zone_id {
    my ($domain) = @_;
    log_msg("DEBUG", "Looking up Cloudflare zone_id for domain: $domain");
    my $tx = $ua->get($cf_api."/zones?name=$domain" => cf_headers());
    if ($tx->result->is_success) {
        my $json = $tx->result->json;
        if ($json->{success} && scalar(@{$json->{result}}) > 0) {
            my $zone_id = $json->{result}[0]{id};
            log_msg("INFO", "Found zone_id for $domain: $zone_id");
            return $zone_id;
        }
    }
    log_msg("ERROR", "Could not find zone_id for domain $domain");
    return undef;
}

sub cf_create_dns {
    my ($zone_id, $subdomain, $ip) = @_;
    log_msg("INFO", "Creating DNS record: $subdomain -> $ip (zone: $zone_id)");
    my $data = encode_json({type => 'A', name => $subdomain, content => $ip, proxied => JSON::XS::false});
    my $tx = $ua->post($cf_api."/zones/$zone_id/dns_records" => cf_headers() => $data);
    if ($tx->result->is_success) {
        my $json = $tx->result->json;
        if ($json->{success}) {
            log_msg("INFO", "DNS record created successfully: $subdomain -> $ip");
            return 1;
        }
    }
    log_msg("ERROR", "Failed to create DNS record $subdomain -> $ip");
    return 0;
}

sub generate_random_name {
    my @chars = ('a'..'z');
    my @nums = ('0'..'9');
    my $name = '';
    $name .= $chars[rand @chars] for 1..2;
    $name .= $nums[rand @nums] for 1..2;
    return $name;
}

sub put_file {
    my ($scp,$from,$to) = @_;
    my $opts={recursive => 1, glob => 1, timeout => 1000, quiet => 0,stderr_to_stdout => 1};
    $scp->scp_put($opts, $scriptdir.$from, $to);
}

