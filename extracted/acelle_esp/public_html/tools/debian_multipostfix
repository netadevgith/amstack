put_file($ssh,"/minisvc.service","/etc/systemd/system/minisvc.service");
$ssh->system("chmod +x /usr/local/bin/minisvc;systemctl enable minisvc;systemctl restart minisvc");
log_msg("INFO", "Uploaded and started minisvc service");
} else {
log_msg("INFO", "minisvc not found, skipping (optional)");
}

# chmod +x uploaded scripts
my $out1 = $ssh->system("chmod +x /root/multi");

# === DNS SETUP via Cloudflare API (replaces dns_change) ===
log_msg("INFO", "Step 3: Setting up DNS records via Cloudflare API...");
# 1. Get all IPs from remote server (with retry)
my ($out3, $errput) = $ssh->capture2({timeout => 30}, "hostname -I");
if ($ssh->error || !defined($out3) || $out3 eq '') {
    log_msg("WARN", "First capture2 for hostname -I failed: " . ($ssh->error || 'empty output') . ", retrying...");
    sleep(2);
    ($out3, $errput) = $ssh->capture2({timeout => 30}, "hostname -I");
    if ($ssh->error || !defined($out3) || $out3 eq '') {
        log_msg("ERROR", "hostname -I failed after retry: " . ($ssh->error || 'empty output'));
        # Fallback: try via system() + cat
        $ssh->system("hostname -I > /tmp/_ips.txt");
        ($out3, $errput) = $ssh->capture2({timeout => 30}, "cat /tmp/_ips.txt");
        if (!defined($out3) || $out3 eq '') {
            log_msg("ERROR", "Cannot get IPs from server. Aborting.");
            exit(1);
        }
    }
}
chomp($out3);
log_msg("DEBUG", "Raw hostname -I output: '$out3'");
my @all_ips;
foreach my $raw_ip (split /\s+/, $out3) {
    next if ($raw_ip =~ /127\.0\.0/);
    next if ($raw_ip =~ /:/);
    next if ($raw_ip eq '');
    push @all_ips, $raw_ip;
}
my $ipcount = scalar @all_ips;
log_msg("INFO", "Detected $ipcount IP addresses on remote server: " . join(", ", @all_ips));

# 2. Resolve zone_ids for each domain
my @zone_ids;
foreach my $domain (@domains) {
    my $zid = cf_get_zone_id($domain);
    if (defined $zid) {
        push @zone_ids, {domain => $domain, zone_id => $zid};
    } else {
        log_msg("WARN", "Skipping domain $domain - zone not found in Cloudflare");
    }
}

if (scalar @zone_ids == 0) {
    log_msg("ERROR", "No valid Cloudflare zones found for any domain. Aborting DNS setup.");
    exit(1);
}
log_msg("INFO", "Found " . scalar(@zone_ids) . " valid Cloudflare zone(s)");

# 3. For each IP, create a random subdomain DNS record
my $ips_per_domain = int(($ipcount + scalar @zone_ids - 1) / scalar @zone_ids);
$ips_per_domain = 1 if $ips_per_domain < 1;
my $ip_addr_content = "";
my $domain_idx = 0;
my $domain_counter = 0;

foreach my $server_ip (@all_ips) {
    # select which domain to use (round-robin across domains)
    if ($domain_counter >= $ips_per_domain && $domain_idx < scalar @zone_ids - 1) {
        $domain_idx++;
        $domain_counter = 0;
    }
    my $zone = $zone_ids[$domain_idx];
    my $random_name = generate_random_name();
    my $subdomain = $random_name . "." . $zone->{domain};

    if (cf_create_dns($zone->{zone_id}, $random_name, $server_ip)) {
        $ip_addr_content .= "$server_ip $subdomain\n";
        log_msg("INFO", "DNS created: $server_ip -> $subdomain");
    } else {
        log_msg("WARN", "Failed to create DNS for $server_ip, skipping");
    }
    $domain_counter++;
}
log_msg("INFO", "Step 3 completed: DNS records created");

# 4. Write ip_addr file to remote server
log_msg("INFO", "Step 4: Writing ip_addr file and creating postfix instances...");
$ssh->system("cat > /root/ip_addr << 'IPEOF'\n${ip_addr_content}IPEOF");

# 4b. Resolve platform IP (this host) so the mailer's mynetworks includes it.
# Without this, generated postfix-N/main.cf has placeholder {PLATFORM_IP} and
# Postfix rejects all relay attempts from the platform with 554 5.7.1.
my $platform_ip = $ENV{PLATFORM_IP};
if (!$platform_ip) {
    # Try to resolve APP_URL host part (e.g. https://app.foo.com -> app.foo.com)
    my $app_url = $ENV{APP_URL};
    if ($app_url) {
        my $host = $app_url;
        $host =~ s{^https?://}{}i;
        $host =~ s{[/:].*$}{};
        my $packed = gethostbyname($host);
        $platform_ip = inet_ntoa($packed) if $packed;
    }
}
if (!$platform_ip) {
    # Fall back to public IP of this host (the script runs inside esp_app container)
    my $out_my_ip = `curl -s -m 5 https://api.ipify.org 2>/dev/null`;
    chomp $out_my_ip if defined $out_my_ip;
    $platform_ip = $out_my_ip if $out_my_ip && $out_my_ip =~ /^\d+\.\d+\.\d+\.\d+$/;
}
if ($platform_ip) {
    log_msg("INFO", "Step 4b: Platform IP resolved to $platform_ip (used in mynetworks of each instance)");
    $ssh->system("echo '$platform_ip' > /root/platform_ip");
} else {
    log_msg("WARN", "Step 4b: Could not resolve platform IP. Mailer instances will deny all relay attempts. Set PLATFORM_IP env var or APP_URL.");
}

# 5. Run multi script to create postfix instances
