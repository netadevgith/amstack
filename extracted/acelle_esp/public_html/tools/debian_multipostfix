  log_msg("INFO", "Step 1 completed: packages installed, postmulti initialized, default instance restricted to 127.0.0.1");
  log_msg("INFO", "NOTE: existing postfix instances are NOT stopped (safety improvement)");

# upload header_checks from local template
log_msg("INFO", "Step 2: Uploading config templates...");
put_file($ssh,"/postfix_configs/header_checks","/etc/postfix/header_checks");

# put multi script and templates to the target vps
