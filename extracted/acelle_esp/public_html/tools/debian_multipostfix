my ($verify_ps, $verify_err) = $ssh->capture2({timeout => 30}, "pgrep -a master 2>/dev/null || echo 'NO MASTER PROCESS'");
if ($ssh->error) {
    log_msg("WARN", "capture2 failed for post-setup verify: " . $ssh->error);
    $verify_ps = 'unknown';
}
chomp($verify_ps);
log_msg("INFO", "Post-setup verification - master processes: $verify_ps");

# 6. Read back ip_addr for result
my ($out_ips, $err_ips) = $ssh->capture2({timeout => 30}, "cat /root/ip_addr");
chomp($out_ips);
my @dnses = split /\n/, $out_ips;
my $count = 0;
my %result;
foreach my $ipas (@dnses) {
next if ($ipas =~ /127.0.0/);
next if ($ipas =~ /:/);
my @parts = split / /, $ipas;
next if (scalar @parts < 2);
$count++;
log_msg("INFO", "IP/DNS mapping: $ipas");
push @{$result{$parts[0]}}, $parts[1];
}
# we need to capture the ip/dns configuration and return it to frontend by json, then frontend can parse it and add servers to it's system
my $json = encode_json(\%result);
log_msg("INFO", "=== MULTI-POSTFIX SETUP COMPLETE === ($count IP/DNS mappings)");
print "JSON: $json\n";
exit(0);
